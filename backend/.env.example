# API Keys (Required)
NEWS_API_KEY=your_news_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Market data for the "Likely Affected Stocks" panel. Server-side only: this
# was VITE_FINNHUB_API_KEY, which Vite compiled into the public browser bundle.
FINNHUB_API_KEY=your_finnhub_api_key_here

# Server Configuration
PORT=3001
NODE_ENV=development

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=600

# CORS: comma-separated allowed origins. Documented as CORS_ORIGIN before,
# which nothing read.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional Services
SCRAPINGDOG_API_KEY=your_scrapingdog_api_key_here  # Optional
SCRAPINGDOG_URL=https://api.scrapingdog.com/google_news/  # Optional

# API URLs
NEWS_API_URL=https://newsapi.org/v2
